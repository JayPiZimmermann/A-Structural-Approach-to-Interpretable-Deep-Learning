% Index style file for thesis
actual '@'
encap '|'
keyword "\\indexentry"
preamble "\\begin{theindex}\n"
postamble "\n\\end{theindex}\n"
item_x1 "\\par\\hangindent 40pt"
item_x2 "\\par\\hangindent 40pt \\hspace*{20pt}"
delim_0   "\\pfill "
delim_1   "\\pfill "
delim_2   "\\pfill "
headings_flag       1
heading_prefix      "{\\bfseries\\hfil "
heading_suffix      "\\hfil}\\nopagebreak\n"
symhead_positive    "{\\bfseries Symbols}"
numhead_positive    "{\\bfseries Numbers}"