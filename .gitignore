## Intermediate documents:
*.dvi
*.xdv
*-converted-to.*

## Generated if empty string is given at "Please type another file name for output:"
*.pdf
# Keep the upstream paper PDF and any imported paper-v2 figure PDFs.
!arxive/downloads/playingTheNetworkBackward/*.pdf
!tex/figures/ptnb_v2/**/*.pdf

## Bibliography auxiliary files (bibtex/biblatex/biber):
*.bbl
# arXiv distributes this paper bibliography as source (no references.bib).
!arxive/playingTheNetworkBackward/main.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml

