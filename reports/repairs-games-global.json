  "source_edits_for_parent_review_only": [
    {
      "locations": [
        "arxive/playingTheNetworkBackward/main.tex: def:routing-recursion",
        "tex/chapters/04_game_theory.tex: corresponding routing definition"
      ],
      "proposed_text": "An admissible profile chooses a pure stop/continue action at each activation state and a probability vector at each linear routing state. Under any profile, evaluate the displayed recursions using those choices, without taking maxima: use the chosen activation action and the chosen routing vector's expected log score plus entropy. A zero-probability term contributes zero even when its score is minus infinity; positive probability on a minus-infinity score makes the routing value minus infinity.",
      "reason": "Makes the exact off-equilibrium utility and strategy domain used by the all-profile proof explicit. This preserves the displayed source primitives."
    },
    {
      "locations": [
        "arxive/playingTheNetworkBackward/main.tex: thm:lrp-recovery and any routing uniqueness remark",
        "tex/chapters/04_game_theory.tex: corresponding uniqueness wording"
      ],
      "proposed_text": "The canonical SPNE selects stopping at every activation-state log tie and selects the absorbing outside action whenever every routing action has zero mass. Without these conventions, nonpositive activation continuations and empty routing streams permit multiple optimal choices.",
      "reason": "An empty routing stream gives every probability vector the same bottom value. Activation tie qualifications alone do not cover that nonuniqueness. The new theorem proves existence and subgame optimality, not an exhaustive uniqueness classification."
    },
    {
      "locations": [
        "arxive/playingTheNetworkBackward/main.tex: paragraph after eq:routing-linear-action",
        "tex/chapters/04_game_theory.tex: corresponding outside-option score"
      ],
      "proposed_edit": "Use ell(epsilon), rather than an unqualified log(epsilon), for the outside-option score when epsilon=0 is allowed.",
      "reason": "Aligns the zero-stabilizer score with the explicitly defined extended logarithm."
    }
  ],
