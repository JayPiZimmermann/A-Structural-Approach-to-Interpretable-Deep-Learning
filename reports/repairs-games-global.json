  "policy_domain": {
    "activation": "Pure stop or continue, with the canonical policy explicitly selecting stop whenever the two source log action values tie (every nonpositive continuation mass).",
    "routing": "Arbitrary finite nonnegative probability vectors summing to one, at every on-path and off-path routing node.",
    "profiles": "A full contingent strategy for each player on the finite unfolded tree. Each player's choices are read only at that player's nodes; both players may deviate at all of their nodes simultaneously.",
    "utilities": "The source's independently defined reported log coordinates, not signed replacement preferences. Routing uses expected extended-log score plus entropy; activation uses its chosen pure action and the displayed two-stream continuation-coordinate formula.",
    "nonnegative_activation_scope": "Concrete physical network activations are ReLU outputs. Negative auxiliary U values represent player-coordinate differences, not a claim that Routing Games globally represent negative GELU activations. Signed raw inputs are handled by the source first-layer product split."
  },
  "proof_chain": [
    {
      "module": "Thesis.RoutingExtended",
      "result": "Defines the genuine extended-score routing objective. Positive policy probability on a nonpositive action mass gives bottom; a zero-probability action contributes zero. Gibbs is optimal for every positive temperature, including zero candidate masses and completely empty streams. Empty streams canonically choose the outside action.",
      "headlines": [
        "sourceValue_gibbs_optimal",
        "gibbs_anchor_mass",
        "gibbs_anchor_nonoutside",
        "empty_stream_value",
        "empty_stream_absorbs",
        "source_edge_score"
      ],
      "bridge": "source_edge_score proves ell(w*exp(V))=ell(w)+V for nonnegative edge weights and arbitrary finite-or-bottom child coordinates. The mass formula therefore matches the source linear action equation, including bottom scores."
    },
    {
      "module": "Thesis.RoutingProfiles",
      "result": "Defines reported log coordinates independently for every profile, proves reported=(ell(U),ell(-U)) and U=exp(V+)-exp(V-), proves a stronger signed saddle by monotone induction, transfers it through monotone ell to Nash for the actual reported utilities, and proves the property recursively at every subgame.",
      "headlines": [
        "reported_coordinates",
        "auxiliary_eq_reported_difference",
        "auxiliary_saddle",
        "canonical_nash",
        "canonical_subgame_perfect",
        "canonical_stops_log_ties"
      ],
      "nonvacuity": "The strategy domain contains the explicitly constructed canonical profile and arbitrary routing distributions. Nash conclusions quantify both players' full deviations; no saddle or best-response conclusion is a hypothesis."
    },
    {
      "module": "Thesis.RoutingNetwork",
      "result": "Builds the unfolded game from the actual shared varying-width Network, signed weights and biases, and epsilon>=0. Outside and bias are separate absorbing actions. First-layer actions split x_i W_ij directly, permitting signed raw inputs; later layers use nonnegative activation values. Every resulting game has a source-log SPNE for theta>0. At theta=1 the auxiliary and reported values recover the actual network evaluation.",
      "headlines": [
        "networkGame_subgame_perfect",
        "networkGame_value",
        "networkGame_reported",
        "networkLayer_reported",
        "inputLayerGames_selected_gate",
        "layerGames_selected_gate",
        "route_anchor_ordinary_probability"
      ],
      "boundary_cases": "Arbitrary zero fan-in, zero bias, epsilon zero, empty sign streams, and nonpositive activation ties are included. Zero predecessor width still has the outside and bias actions."
    }
  ],
