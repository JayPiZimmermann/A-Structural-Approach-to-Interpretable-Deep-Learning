                          Monotone (h i).eval ∧
                            ConvexOn ℝ Set.univ (g i).eval ∧
                              ConvexOn ℝ Set.univ (h i).eval ∧
                                ∀ (c : ℝ),
                                  0 ≤ c →
                                    ∀ (x : Fin n ⊕ Fin n → ℝ),
                                      (g i).eval (c • x) = c * (g i).eval x ∧ (h i).eval (c • x) = c * (h i).eval x) ∧
              (∀ (p q : Fin n → ℝ),
                  (fun i => (g i).eval (Sum.elim p q)) = wp *ᵥ (net.split p q).1 + wn *ᵥ (net.split p q).2 ∧
                    (fun i => (h i).eval (Sum.elim p q)) = wn *ᵥ (net.split p q).1 + wp *ᵥ (net.split p q).2) ∧
                (∀ (p q : Fin n → ℝ) (i : Fin k),
                    (g i).eval (Sum.elim p q) - (h i).eval (Sum.elim p q) = ((wp - wn) *ᵥ net.eval (p - q)) i) ∧
                  ∀ (i : Fin k),
                    (g i).newton = ∑ j, wp i j • (hidden.1 j).newton + ∑ j, wn i j • (hidden.2 j).newton ∧
                      (h i).newton = ∑ j, wn i j • (hidden.1 j).newton + ∑ j, wp i j • (hidden.2 j).newton
