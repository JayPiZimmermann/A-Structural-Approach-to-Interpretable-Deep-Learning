  net.Nonnegative →
    NonzeroRows net →
      ∀ (x : Fin n → ℝ) (plus minus : Strategy net) (wp wn : Matrix (Fin k) (Fin m) ℝ) (b : Fin k → ℝ),
        (∀ (i : Fin k) (j : Fin m), 0 ≤ wp i j) →
          (∀ (i : Fin k) (j : Fin m), 0 ≤ wn i j) →
            (∀ (i : Fin k), rowDiscount wp wn i ≠ 0) →
              ∀ (i : Fin k),
                have read := fun v => continuation wp wn b v.1 v.2 i;
                have logit := ((wp - wn) *ᵥ net.eval x + b) i;
                read (policyValue net plus (optimalStrategy net x) x (-x)) ≤ logit ∧
                  read (policyValue net (optimalStrategy net x) (optimalStrategy net x) x (-x)) = logit ∧
                    logit ≤ read (policyValue net (optimalStrategy net x) minus x (-x)) ∧
                      (SubgamePerfect net plus minus x (-x) ↔
                          GateOptimalStrategy net x plus ∧ GateOptimalStrategy net x minus) ∧
                        (SubgamePerfect net plus minus x (-x) → read (policyValue net plus minus x (-x)) = logit)
