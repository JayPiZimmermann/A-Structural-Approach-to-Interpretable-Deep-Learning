            have hidden := tropicalSplit net (inputPolynomials n).1 (inputPolynomials n).2;
            have g := polynomialAffine wp wn 0 hidden.1 hidden.2;
            have h := polynomialAffine wn wp 0 hidden.1 hidden.2;
            (∀ (i : Fin k),
                (g i).ZeroIntercepts ∧
                  (h i).ZeroIntercepts ∧
                    (g i).NonnegativeSlopes ∧
