@Thesis.ConditionedSurvival.weighted_path_identity : ∀ {S : Type} [inst : Fintype S] (n : ℕ) (K : ℕ → S → S → ℝ)
  (h : ℕ → S → ℝ),
  (∀ (i : ℕ) (s t : S), 0 ≤ K i s t) →
    (∀ (i : ℕ) (s : S), 0 ≤ h i s) →
      (∀ i < n, ∀ (s : S), h i s = ∑ t, K i s t * h (i + 1) t) →
        ∀ (s : S) (path : Thesis.Games.Paths S n),
          Thesis.Games.pathLaw n (Thesis.ConditionedSurvival.kernel K h) s path * h 0 s =
            Thesis.Games.pathLaw n K s path * h n (Thesis.Games.endpoint n s path)
