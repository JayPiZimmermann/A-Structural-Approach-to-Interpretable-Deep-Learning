@Thesis.ConditionedSurvival.conditioned_survival : ∀ {S : Type} [inst : Fintype S] (N : ℕ) (K : ℕ → S → S → ℝ),
  (∀ (i : ℕ) (s t : S), 0 ≤ K i s t) →
    (∀ (i : ℕ) (s : S), ∑ t, K i s t ≤ 1) →
      ∀ (s : S),
        0 < Thesis.ConditionedSurvival.survival N K 0 s →
          (∀ (i : ℕ) (t : S),
              0 ≤ Thesis.ConditionedSurvival.survival N K i t ∧ Thesis.ConditionedSurvival.survival N K i t ≤ 1) ∧
            (∀ (t : S), Thesis.ConditionedSurvival.survival N K N t = 1) ∧
              (∀ i < N,
                  ∀ (u : S),
                    Thesis.ConditionedSurvival.survival N K i u =
                      ∑ t, K i u t * Thesis.ConditionedSurvival.survival N K (i + 1) t) ∧
                Thesis.ConditionedSurvival.survival N K 0 s = ∑ path, Thesis.Games.pathLaw N K s path ∧
                  (∀ i < N,
                      ∀ (u : S),
                        ∑ t, Thesis.ConditionedSurvival.kernel K (Thesis.ConditionedSurvival.survival N K) i u t =
                          if 0 < Thesis.ConditionedSurvival.survival N K i u then 1 else 0) ∧
                    (∀ (i : ℕ) (u t : S),
                        Thesis.ConditionedSurvival.survival N K (i + 1) t = 0 →
                          Thesis.ConditionedSurvival.kernel K (Thesis.ConditionedSurvival.survival N K) i u t = 0) ∧
                      (∀ (path : Thesis.Games.Paths S N),
                          Thesis.Games.pathLaw N
                              (Thesis.ConditionedSurvival.kernel K (Thesis.ConditionedSurvival.survival N K)) s path =
                            Thesis.Games.pathLaw N K s path / Thesis.ConditionedSurvival.survival N K 0 s) ∧
                        ∑ path,
                              Thesis.Games.pathLaw N
                                (Thesis.ConditionedSurvival.kernel K (Thesis.ConditionedSurvival.survival N K)) s path =
                            1 ∧
                          ∀ (path : Thesis.Games.Paths S N),
                            ∀ i ≤ N,
                              Thesis.ConditionedSurvival.survival N K i
                                    (Thesis.ConditionedSurvival.stateAt N s path i) =
                                  0 →
                                Thesis.Games.pathLaw N
                                    (Thesis.ConditionedSurvival.kernel K (Thesis.ConditionedSurvival.survival N K)) s
                                    path =
                                  0
