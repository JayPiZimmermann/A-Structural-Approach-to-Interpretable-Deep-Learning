@Thesis.ConditionedSurvival.trajectory_bc_monotone : ∀ {S : Type} [inst : Fintype S] (A B : ℕ → S → S → ℝ),
  (∀ (i : ℕ) (s t : S), 0 ≤ A i s t) →
    (∀ (i : ℕ) (s t : S), 0 ≤ B i s t) →
      (∀ (i : ℕ) (s : S), ∑ t, A i s t = 1) →
        (∀ (i : ℕ) (s : S), ∑ t, B i s t = 1) →
          ∀ (s : S),
            Thesis.Games.overlap (Thesis.Games.pathLaw 0 A s) (Thesis.Games.pathLaw 0 B s) = 1 ∧
              (∀ (n : ℕ),
                  0 ≤ Thesis.Games.overlap (Thesis.Games.pathLaw n A s) (Thesis.Games.pathLaw n B s) ∧
                    Thesis.Games.overlap (Thesis.Games.pathLaw n A s) (Thesis.Games.pathLaw n B s) ≤ 1) ∧
                (Antitone fun n => Thesis.Games.overlap (Thesis.Games.pathLaw n A s) (Thesis.Games.pathLaw n B s)) ∧
                  (Monotone fun n =>
                      1 / 2 * ∑ path, (√(Thesis.Games.pathLaw n A s path) - √(Thesis.Games.pathLaw n B s path)) ^ 2) ∧
                    (∀ (n : ℕ),
                        1 / 2 * ∑ path, (√(Thesis.Games.pathLaw n A s path) - √(Thesis.Games.pathLaw n B s path)) ^ 2 =
                          1 - Thesis.Games.overlap (Thesis.Games.pathLaw n A s) (Thesis.Games.pathLaw n B s)) ∧
                      ∀ (n : ℕ),
                        Thesis.Games.overlap (Thesis.Games.pathLaw n A s) (Thesis.Games.pathLaw n B s) =
                          Thesis.Games.backwardDP n (fun i u v => √(A i u v * B i u v)) (fun x => 1) s
