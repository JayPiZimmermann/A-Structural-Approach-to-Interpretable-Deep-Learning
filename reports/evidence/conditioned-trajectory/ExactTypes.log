@Thesis.ConditionedSurvival.conditioned_survival_statistics : ∀ {S : Type} [inst : Fintype S] (N : ℕ)
  (A B : ℕ → S → S → ℝ),
  (∀ (i : ℕ) (s t : S), 0 ≤ A i s t) →
    (∀ (i : ℕ) (s t : S), 0 ≤ B i s t) →
      (∀ (i : ℕ) (s : S), ∑ t, A i s t ≤ 1) →
        (∀ (i : ℕ) (s : S), ∑ t, B i s t ≤ 1) →
          ∀ (s : S),
            0 < Thesis.ConditionedSurvival.survival N A 0 s →
              0 < Thesis.ConditionedSurvival.survival N B 0 s →
                (Thesis.ConditionedSurvival.survival N A 0 s ≤ 1 ∧ Thesis.ConditionedSurvival.survival N B 0 s ≤ 1) ∧
                  (∀ i ≤ N,
                      ∀ (t : S),
                        Thesis.ConditionedSurvival.timeMass N i
                              (Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A)) s t =
                            Thesis.ConditionedSurvival.prefixMass i A s t *
                                Thesis.ConditionedSurvival.survival N A i t /
                              Thesis.ConditionedSurvival.survival N A 0 s ∧
                          Thesis.ConditionedSurvival.timeMass N i
                              (Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B)) s t =
                            Thesis.ConditionedSurvival.prefixMass i B s t *
                                Thesis.ConditionedSurvival.survival N B i t /
                              Thesis.ConditionedSurvival.survival N B 0 s) ∧
                    (∀ (i : ℕ) (u v : S),
                        √(Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A) i u v *
                              Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B) i u v) =
                          √(A i u v * B i u v) *
                              √(Thesis.ConditionedSurvival.survival N A (i + 1) v *
                                  Thesis.ConditionedSurvival.survival N B (i + 1) v) /
                            √(Thesis.ConditionedSurvival.survival N A i u *
                                Thesis.ConditionedSurvival.survival N B i u)) ∧
                      Thesis.Games.overlap
                            (Thesis.Games.pathLaw N
                              (Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A)) s)
                            (Thesis.Games.pathLaw N
                              (Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B)) s) =
                          ∑ path,
                            Thesis.Games.pathLaw N
                              (fun i u v =>
                                √(Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A) i u v *
                                    Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B) i u
                                      v))
                              s path ∧
                        Thesis.Games.overlap
                              (Thesis.Games.pathLaw N
                                (Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A)) s)
                              (Thesis.Games.pathLaw N
                                (Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B)) s) =
                            Thesis.Games.backwardDP N
                              (fun i u v =>
                                √(Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A) i u v *
                                    Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B) i u
                                      v))
                              (fun x => 1) s ∧
                          Thesis.Games.overlap
                                (Thesis.Games.pathLaw N
                                  (Thesis.ConditionedSurvival.kernel A (Thesis.ConditionedSurvival.survival N A)) s)
                                (Thesis.Games.pathLaw N
                                  (Thesis.ConditionedSurvival.kernel B (Thesis.ConditionedSurvival.survival N B)) s) =
                              Thesis.Randomization.ordinaryOverlap N A B s /
                                √(Thesis.ConditionedSurvival.survival N A 0 s *
                                    Thesis.ConditionedSurvival.survival N B 0 s) ∧
                            1 / 2 *
                                ∑ path,
                                  (√(Thesis.Games.pathLaw N
                                          (Thesis.ConditionedSurvival.kernel A
                                            (Thesis.ConditionedSurvival.survival N A))
                                          s path) -
                                      √(Thesis.Games.pathLaw N
                                          (Thesis.ConditionedSurvival.kernel B
                                            (Thesis.ConditionedSurvival.survival N B))
                                          s path)) ^
                                    2 =
                              1 -
                                Thesis.Randomization.ordinaryOverlap N A B s /
                                  √(Thesis.ConditionedSurvival.survival N A 0 s *
                                      Thesis.ConditionedSurvival.survival N B 0 s)
