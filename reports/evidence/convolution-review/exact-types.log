@HiddenMonotonicity.Network.mixing_one_convex_input : ∀ {d n m : ℕ} (net : HiddenMonotonicity.Network n m),
  net.Nonnegative →
    ∀ (p q : HiddenMonotonicity.Vec d → HiddenMonotonicity.Vec n),
      (∀ (i : Fin n), ConvexOn ℝ Set.univ fun x => p x i) →
        (∀ (i : Fin n), ConvexOn ℝ Set.univ fun x => q x i) →
          (∀ (i : Fin m),
              ConvexOn ℝ Set.univ fun x => (net.decomposeWith (HiddenMonotonicity.mixPair 1) (p x, q x)).1 i) ∧
            (∀ (i : Fin m),
                ConvexOn ℝ Set.univ fun x => (net.decomposeWith (HiddenMonotonicity.mixPair 1) (p x, q x)).2 i) ∧
              ∀ (x : HiddenMonotonicity.Vec d),
                (net.decomposeWith (HiddenMonotonicity.mixPair 1) (p x, q x)).1 -
                    (net.decomposeWith (HiddenMonotonicity.mixPair 1) (p x, q x)).2 =
                  net.eval (p x - q x)
