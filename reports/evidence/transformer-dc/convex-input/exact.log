  [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (s : Set E),
  Convex ℝ s →
    ∀ (φ : (ι → ℝ) × (ι → ℝ) → ℝ),
      ConvexOn ℝ (Set.Ici 0) φ →
        MonotoneOn φ (Set.Ici 0) →
