            (∀ (i : ι), ConvexOn ℝ s fun x => p x i) →
              (∀ (i : ι), ConvexOn ℝ s fun x => q x i) →
                (∀ x ∈ s, 0 ≤ p x) → (∀ x ∈ s, 0 ≤ q x) → ConvexOn ℝ s fun x => φ (p x, q x)
