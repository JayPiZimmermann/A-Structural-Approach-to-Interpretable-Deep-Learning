@Thesis.RoutingExpectation.conditional_affinity_contraction.{u_1} : ∀ {Ω : Type u_1} [mΩ : MeasurableSpace.{u_1} Ω]
  {S : Type} [inst : Fintype.{0} S] [inst_1 : DecidableEq.{1} S] (μ : MeasureTheory.Measure.{u_1} Ω)
  [MeasureTheory.IsProbabilityMeasure.{u_1} μ] (ℱ : ℕ → MeasurableSpace.{u_1} Ω),
  (∀ (n : ℕ), LE.le.{u_1} (ℱ n) mΩ) →
    ∀ (A : ℕ → S → S → ℝ) (B : ℕ → Ω → S → S → ℝ) (s₀ : S) (b : ℝ),
      LE.le.{0} 0 b →
        (∀ (n : ℕ) (s : S),
            MeasureTheory.Integrable.{0, u_1}
              (fun ω =>
                Thesis.RandomizationExpectation.randomPrefix.{u_1}
                  (Thesis.RandomizationExpectation.modelKernel.{u_1} A B) s₀ n ω s)
              μ) →
          (∀ (n : ℕ) (s : S),
              MeasureTheory.Integrable.{0, u_1} (Thesis.RoutingExpectation.rowAffinity.{u_1} A B n s) μ) →
            (∀ (n : ℕ) (s : S),
                MeasureTheory.Integrable.{0, u_1}
                  (fun ω =>
                    HMul.hMul.{0, 0, 0}
                      (Thesis.RandomizationExpectation.randomPrefix.{u_1}
                        (Thesis.RandomizationExpectation.modelKernel.{u_1} A B) s₀ n ω s)
                      (Thesis.RoutingExpectation.rowAffinity.{u_1} A B n s ω))
                  μ) →
              (∀ (n : ℕ) (s : S),
                  MeasureTheory.AEStronglyMeasurable.{u_1, 0}
                    (fun ω =>
                      Thesis.RandomizationExpectation.randomPrefix.{u_1}
                        (Thesis.RandomizationExpectation.modelKernel.{u_1} A B) s₀ n ω s)
                    μ) →
                ∀ (n : ℕ),
                  (∀ (l : ℕ),
                      LT.lt.{0} l n →
                        ∀ (s : S),
                          ∀ᵐ (ω : Ω) ∂μ,
                            LE.le.{0}
                              (MeasureTheory.condExp.{u_1, 0} (ℱ l) μ
                                (Thesis.RoutingExpectation.rowAffinity.{u_1} A B l s) ω)
                              b) →
                    LE.le.{0} (∫ (ω : Ω), Thesis.Randomization.ordinaryOverlap n A (fun l => B l ω) s₀ ∂μ)
                      (HPow.hPow.{0, 0, 0} b n)
