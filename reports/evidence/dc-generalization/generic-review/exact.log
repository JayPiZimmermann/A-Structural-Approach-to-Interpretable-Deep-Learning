  ConvexOn ℝ Set.univ P →
    ConvexOn ℝ Set.univ Q →
      (∀ (a b : ℝ), a ≤ b → 0 ≤ P b - P a ∧ P b - P a ≤ L * (b - a)) →
        (∀ (a b : ℝ), a ≤ b → 0 ≤ Q b - Q a ∧ Q b - Q a ≤ L * (b - a)) →
          (∀ (t : ℝ), P t - Q t = f t) →
            ConvexOn ℝ Set.univ (HiddenMonotonicity.SmoothDC.asymmetricLift P L) ∧
              ConvexOn ℝ Set.univ (HiddenMonotonicity.SmoothDC.asymmetricLift Q L) ∧
                Monotone (HiddenMonotonicity.SmoothDC.asymmetricLift P L) ∧
                  Monotone (HiddenMonotonicity.SmoothDC.asymmetricLift Q L) ∧
                    ∀ (z : ℝ × ℝ),
                      HiddenMonotonicity.SmoothDC.asymmetricLift P L z -
                          HiddenMonotonicity.SmoothDC.asymmetricLift Q L z =
                        f (z.1 - z.2)
