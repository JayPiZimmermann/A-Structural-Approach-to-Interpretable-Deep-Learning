HiddenMonotonicity.SmoothDC.swish_curvature_turning_sign : ∀ (β : ℝ),
  0 < β →
    ∀ (x : ℝ),
      (0 < HiddenMonotonicity.SmoothDC.curvature (HiddenMonotonicity.SmoothDC.swish β) x ↔
          |β * x| < HiddenMonotonicity.SmoothDC.swishTurningPoint) ∧
        (HiddenMonotonicity.SmoothDC.curvature (HiddenMonotonicity.SmoothDC.swish β) x < 0 ↔
            HiddenMonotonicity.SmoothDC.swishTurningPoint < |β * x|) ∧
          (HiddenMonotonicity.SmoothDC.curvature (HiddenMonotonicity.SmoothDC.swish β) x = 0 ↔
            |β * x| = HiddenMonotonicity.SmoothDC.swishTurningPoint)
'_ThesisExactChecks.target_0' depends on axioms: [propext, Classical.choice, Quot.sound]
