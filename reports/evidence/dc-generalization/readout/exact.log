@HiddenMonotonicity.Network.affineDecomposeWith_recovery : ∀ {n m k : ℕ} (net : HiddenMonotonicity.Network n m)
  (σ : ℝ → ℝ) (φ : ℝ × ℝ → ℝ × ℝ),
  HiddenMonotonicity.ValidPairActivation σ φ →
    ∀ (wp wn : Matrix (Fin k) (Fin m) ℝ) (bp bn : HiddenMonotonicity.Vec k) (x : HiddenMonotonicity.PairVec n),
      (net.affineDecomposeWith φ wp wn bp bn x).1 - (net.affineDecomposeWith φ wp wn bp bn x).2 =
        HiddenMonotonicity.affineLayer wp wn bp bn (net.forwardWith σ (x.1 - x.2))
