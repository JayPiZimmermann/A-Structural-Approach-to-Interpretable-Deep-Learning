@HiddenMonotonicity.Network.decomposeWith_convex_input : ∀ {d n m : ℕ} (net : HiddenMonotonicity.Network n m),
  net.Nonnegative →
    ∀ (φ : ℝ × ℝ → ℝ × ℝ),
      Monotone φ →
        HiddenMonotonicity.ConvexPairActivation φ →
          ∀ (p q : HiddenMonotonicity.Vec d → HiddenMonotonicity.Vec n),
            (∀ (i : Fin n), ConvexOn ℝ Set.univ fun x => p x i) →
              (∀ (i : Fin n), ConvexOn ℝ Set.univ fun x => q x i) →
                (∀ (i : Fin m), ConvexOn ℝ Set.univ fun x => (net.decomposeWith φ (p x, q x)).1 i) ∧
                  ∀ (i : Fin m), ConvexOn ℝ Set.univ fun x => (net.decomposeWith φ (p x, q x)).2 i
