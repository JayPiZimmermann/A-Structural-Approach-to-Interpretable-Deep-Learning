@HiddenMonotonicity.Network.convex_monotone_decomposition : ∀ {n m : ℕ} (net : HiddenMonotonicity.Network n m),
  net.Nonnegative →
    ∀ (σ : ℝ → ℝ) (φ : ℝ × ℝ → ℝ × ℝ),
      HiddenMonotonicity.ValidPairActivation σ φ →
        Monotone φ →
          HiddenMonotonicity.ConvexPairActivation φ →
            Monotone (net.decomposeWith φ) ∧
              (∀ (i : Fin m), ConvexOn ℝ Set.univ fun x => (net.decomposeWith φ x).1 i) ∧
                (∀ (i : Fin m), ConvexOn ℝ Set.univ fun x => (net.decomposeWith φ x).2 i) ∧
                  ∀ (x : HiddenMonotonicity.PairVec n),
                    (net.decomposeWith φ x).1 - (net.decomposeWith φ x).2 = net.forwardWith σ (x.1 - x.2)
