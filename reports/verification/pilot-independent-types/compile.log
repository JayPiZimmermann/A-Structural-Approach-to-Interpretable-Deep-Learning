@HiddenMonotonicity.Network.stabilized_backward_absolute_Q_closed_form : ∀ {n m : ℕ}
  (net : HiddenMonotonicity.Network n m),
  net.Canonical →
    ∀ (x : HiddenMonotonicity.Vec n),
      net.Strict x →
        ∀ (α : ℕ → ℝ) (r : HiddenMonotonicity.Row m),
          (∀ q ∈ net.absoluteQSources x α, HasFDerivAt q.value q.jacobian x) ∧
            HiddenMonotonicity.unified ((net.originalTrace x).stabilized α r true) =
