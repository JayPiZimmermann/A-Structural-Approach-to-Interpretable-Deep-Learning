              HiddenMonotonicity.unified
                  ((net.originalTrace x).run α (HiddenMonotonicity.affineReadoutSeed rPlus rMinus β false)) =
                (-1 / 2) •
                  ((rPlus - rMinus) ∘SL (net.originalTrace x).originalJac +
                    (HiddenMonotonicity.sourceRows (net.absoluteQSources x α) ((1 - 2 * β) • (rPlus + rMinus))).sum)
