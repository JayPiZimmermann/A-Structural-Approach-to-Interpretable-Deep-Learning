              HiddenMonotonicity.unified ((net.originalTrace x).stabilized α r false) =
                (-1 / 2) •
                  (r ∘SL (net.originalTrace x).originalJac +
                    (HiddenMonotonicity.sourceRows (net.absoluteQSources x α) r).sum)
