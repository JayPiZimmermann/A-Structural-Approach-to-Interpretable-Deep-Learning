        (∀ (i : Fin k) (j : Fin m), 0 ≤ wp i j) →
          (∀ (i : Fin k) (j : Fin m), 0 ≤ wn i j) →
            have hidden :=
              Thesis.Tropical.tropicalSplit net (Thesis.Tropical.inputPolynomials n).1
                (Thesis.Tropical.inputPolynomials n).2;
            have g := Thesis.Tropical.polynomialAffine wp wn 0 hidden.1 hidden.2;
            have h := Thesis.Tropical.polynomialAffine wn wp 0 hidden.1 hidden.2;
            (∀ (i : Fin k),
                (g i).ZeroIntercepts ∧
                  (h i).ZeroIntercepts ∧
                    (g i).NonnegativeSlopes ∧
                      (h i).NonnegativeSlopes ∧
                        Monotone (g i).eval ∧
                          Monotone (h i).eval ∧
                            ConvexOn ℝ Set.univ (g i).eval ∧
                              ConvexOn ℝ Set.univ (h i).eval ∧
                                ∀ (c : ℝ),
                                  0 ≤ c →
                                    ∀ (x : Fin n ⊕ Fin n → ℝ),
                                      (g i).eval (c • x) = c * (g i).eval x ∧ (h i).eval (c • x) = c * (h i).eval x) ∧
              (∀ (p q : Fin n → ℝ),
                  (fun i => (g i).eval (Sum.elim p q)) = wp.mulVec (net.split p q).1 + wn.mulVec (net.split p q).2 ∧
                    (fun i => (h i).eval (Sum.elim p q)) = wn.mulVec (net.split p q).1 + wp.mulVec (net.split p q).2) ∧
                (∀ (p q : Fin n → ℝ) (i : Fin k),
                    (g i).eval (Sum.elim p q) - (h i).eval (Sum.elim p q) = (wp - wn).mulVec (net.eval (p - q)) i) ∧
                  ∀ (i : Fin k),
                    (g i).newton = ∑ j, wp i j • (hidden.1 j).newton + ∑ j, wn i j • (hidden.2 j).newton ∧
                      (h i).newton = ∑ j, wn i j • (hidden.1 j).newton + ∑ j, wp i j • (hidden.2 j).newton
