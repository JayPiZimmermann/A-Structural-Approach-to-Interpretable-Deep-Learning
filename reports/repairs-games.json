    {
      "id": "GR02",
      "audit_findings": [
        "AG01",
        "AG03"
      ],
      "modules": [
        "Thesis.StoppingBoundary"
      ],
      "result": "Total SG transition row absorbs an open zero-fan-in neuron; normalization and nonnegativity proved. Zero total nonnegative weight implies every ordinary edge is zero, so discount recovery no longer needs PositiveFanIn. This extends selected-mask occupation identities, actual strict-cell network derivatives, actual strict-cell stopping-stream derivatives, and actual signed affine-readout derivatives.",
      "scope": "Classical derivatives retain Strict. Tied selected-mask identities are algebraic backward operators and are never described as derivatives of discontinuous stopping streams. Nonnegative split weights are explicit."
    },
    {
      "id": "GR03",
      "audit_findings": [
        "AG03"
      ],
      "modules": [
        "Thesis.SoftplusBoundary"
      ],
      "result": "Sigmoid stopping is mixed with the total SG continuation row; zero fan-in is fully absorbed. The real Softplus network derivative equals discounted signed occupation without PositiveFanIn.",
      "scope": "Positive temperature and nonnegative split weights; full global Softplus SPNE is not asserted."
    },
    {
      "id": "GR04",
      "audit_findings": [
        "AG08"
      ],
      "modules": [
        "Thesis.RoutingSupport"
      ],
      "result": "Defines the literal ungated source recurrence and proves equality to existing gated LRP for output seeds vanishing on zero activations. Output activation seeds satisfy support. An ungated signed affine readout automatically produces supported backbone seeds, yielding source affine-output LRP recovery for arbitrary readout seeds.",
      "scope": "Addresses the missing source-model bridge rather than assuming the ungated and gated definitions coincide. Empty denominators use the source's real-division 0/0=0 convention."
    },
    {
      "id": "GR05",
      "audit_findings": [
        "AG02",
        "AG03",
        "AG06"
      ],
      "modules": [
        "Thesis.RoutingTransitions"
      ],
      "result": "Constructs nonnegative normalized natural RG rows with actual contribution masses, bias and stabilizer denominators, cemetery absorption for missing/empty stream mass, and the explicit log-space gate. Epsilon zero is included; ordinary path probabilities and occupations are proved nonnegative at epsilon>=0.",
      "scope": "This is the natural biased routing model. It does not identify a bias-omitted diagnostic as its marginal, and stochastic row normalization is not a claim of ordinary alpha-beta relevance conservation. Occupation nonnegativity additionally requires alpha,beta>=0."
    },
    {
      "id": "GR06",
      "audit_findings": [
        "AG05"
      ],
      "modules": [
        "Thesis.RoutingExpectation"
      ],
      "result": "Actual conditional expectation of the ordinary sqrt(A*B) row affinity bounded by b yields expected complete-prefix overlap at most b^n, with the same bound after additional substochastic layers.",
      "scope": "Arbitrary probability space, explicit above-layer sigma algebra, prefix measurability and integrability. Does not infer conditional contraction from continuous, symmetric, or Gaussian parameter randomization. The theorem is valid for b>=0; exponential decay specifically requires b<1."
